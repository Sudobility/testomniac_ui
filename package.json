{
  "name": "@sudobility/testomniac_ui",
  "version": "0.0.66",
  "description": "Shared dashboard UI components, pages, and hooks for Testomniac apps (router/i18n-agnostic)",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist/**/*"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:watch": "tsc -p tsconfig.build.json --watch",
    "clean": "rm -rf dist",
    "prepublishOnly": "bun run clean && bun run build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\"",
    "test:unit": "vitest run --passWithNoTests",
    "test:watch": "vitest --passWithNoTests",
    "verify": "bun run typecheck && bun run lint && bun run format:check && bun run test:unit && bun run build"
  },
  "peerDependencies": {
    "@heroicons/react": ">=2.0.0",
    "@sudobility/components": "^5.3.45",
    "@sudobility/design": "^1.1.66",
    "@sudobility/testomniac_client": "^0.0.141",
    "@sudobility/testomniac_lib": "^0.0.145",
    "@sudobility/testomniac_types": "^0.0.115",
    "@sudobility/types": "^1.9.76",
    "@tanstack/react-query": ">=5.0.0",
    "@tanstack/react-table": ">=8.0.0",
    "@xyflow/react": ">=12.0.0",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "devDependencies": {
    "@eslint/js": "~10.0.1",
    "@heroicons/react": "~2.2.0",
    "@sudobility/components": "^5.3.45",
    "@sudobility/design": "^1.1.66",
    "@sudobility/testomniac_client": "^0.0.141",
    "@sudobility/testomniac_lib": "^0.0.145",
    "@sudobility/testomniac_types": "^0.0.115",
    "@sudobility/types": "^1.9.76",
    "@tanstack/react-query": "~5.104.5",
    "@tanstack/react-table": "~8.21.3",
    "@types/react": "~19.3.0",
    "@types/react-dom": "~19.3.0",
    "@xyflow/react": "~12.12.0",
    "eslint": "~10.13.0",
    "eslint-plugin-react-hooks": "~7.1.1",
    "globals": "~17.13.0",
    "prettier": "~3.9.10",
    "react": "~19.3.1",
    "react-dom": "~19.3.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "~8.72.0",
    "vitest": "~4.1.12"
  },
  "license": "BUSL-1.1",
  "repository": {
    "type": "git",
    "url": "https://github.com/Sudobility/testomniac_ui.git"
  },
  "dependencies": {}
}
